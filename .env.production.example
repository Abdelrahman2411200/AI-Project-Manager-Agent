# Copy to a host-owned, mode-0600 environment file. Never commit real values.
APP_ENV=production
APP_VERSION=0.13.0
PUBLIC_ORIGIN=https://project-manager.example.edu
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

POSTGRES_DB=project_manager
POSTGRES_USER=project_manager
# URL-safe, unique value. Generate it; do not reuse this placeholder.
POSTGRES_PASSWORD=replace-with-a-url-safe-random-database-password
DATABASE_URL=postgresql+psycopg://project_manager:replace-with-a-url-safe-random-database-password@db:5432/project_manager

SESSION_HASH_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=true
CORS_ORIGINS=["https://project-manager.example.edu"]
AI_PROVIDER=none
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_CONTEXT_TOKENS=8192
OLLAMA_MAX_OUTPUT_TOKENS=4096
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
LOG_LEVEL=INFO

BACKUP_PASSPHRASE=replace-with-a-separate-random-backup-passphrase
BACKUP_RETENTION_DAYS=35
