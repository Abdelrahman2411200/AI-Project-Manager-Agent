APP_NAME=AI Project Manager API
APP_ENV=development
APP_VERSION=0.13.0
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://project_manager:project_manager@db:5432/project_manager
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT_SECONDS=10
API_THREAD_LIMIT=100
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
SESSION_HASH_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
REQUEST_MAX_BODY_BYTES=1048576
REQUEST_TIMEOUT_SECONDS=30
PDF_RENDER_TIMEOUT_SECONDS=60
PDF_MAX_BYTES=10485760
PDF_MAX_CONCURRENCY=2
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_CONTEXT_TOKENS=8192
OLLAMA_MAX_OUTPUT_TOKENS=4096
OLLAMA_TEMPERATURE=0
OLLAMA_SEED=42
OLLAMA_KEEP_ALIVE=5m
OLLAMA_SCHEMA_RETRIES=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=90
OPENAI_REASONING_EFFORT=low
OPENAI_VERBOSITY=low
PLANNING_RUN_DEFAULT_TOKEN_BUDGET=50000
USER_DAILY_RUN_LIMIT=10
USER_DAILY_TOKEN_BUDGET=200000
MODEL_INPUT_PRICE_PER_MILLION=2.50
MODEL_CACHED_INPUT_PRICE_PER_MILLION=0.25
MODEL_OUTPUT_PRICE_PER_MILLION=15.00
DAILY_MODEL_COST_BUDGET_USD=50.00
QUEUE_AGE_ALERT_SECONDS=300
PROVIDER_FAILURE_ALERT_RATIO=0.20
DAILY_COST_ALERT_RATIO=0.80
OTEL_SERVICE_NAME=ai-project-manager-api
OTEL_EXPORTER_OTLP_ENDPOINT=
JOB_HEARTBEAT_SECONDS=15
JOB_LEASE_SECONDS=90
JOB_POLL_SECONDS=1

POSTGRES_DB=project_manager
POSTGRES_USER=project_manager
POSTGRES_PASSWORD=project_manager

VITE_API_BASE_URL=http://localhost:8000/api/v1
