# Synthetic local demonstration values only. Do not reuse them in another environment.
APP_ENV=demo
APP_VERSION=0.13.0
HTTP_PORT=8080
DEMO_ORIGIN=http://localhost:8080
POSTGRES_DB=project_manager_demo
POSTGRES_USER=project_manager_demo
POSTGRES_PASSWORD=demo-database-only
DATABASE_URL=postgresql+psycopg://project_manager_demo:demo-database-only@db:5432/project_manager_demo
SESSION_HASH_SECRET=university-demo-session-secret-32-characters
COOKIE_SECURE=false
DEMO_OWNER_PASSWORD=SyntheticDemoOnly!2026
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_CONTEXT_TOKENS=8192
OLLAMA_MAX_OUTPUT_TOKENS=4096
OLLAMA_TEMPERATURE=0
OLLAMA_SEED=42
OLLAMA_KEEP_ALIVE=5m
OLLAMA_SCHEMA_RETRIES=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
MODEL_INPUT_PRICE_PER_MILLION=0
MODEL_CACHED_INPUT_PRICE_PER_MILLION=0
MODEL_OUTPUT_PRICE_PER_MILLION=0
USER_DAILY_RUN_LIMIT=100
USER_DAILY_TOKEN_BUDGET=2000000
